#ifndef THATmcDigit_hxx_seen
#define THATmcDigit_hxx_seen

#include <THATDigit.hxx>
#include <TMCDigit.hxx>

namespace ND {
    class THATmcDigit;
};

/// A class to hold HAT digits generated by the MC.  This inherits all of it's
/// functionality form THATDigit and TMCDigit.
class ND::THATmcDigit : public THATDigit, public TMCDigit {
public:

    THATmcDigit ();
    virtual ~THATmcDigit();

    /// Construct a digit for a particular channel
    THATmcDigit(ND::TChannelId chan, 
                short startTime, 
                std::vector<short> adcs,
                const ND::TMCDigit::ContributorContainer& contrib);

    ClassDef(THATmcDigit,2);
};
#endif
