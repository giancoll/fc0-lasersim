#ifndef TSFGmcDigit_hxx_seen
#define TSFGmcDigit_hxx_seen

#include <TSFGDigit.hxx>
#include <TMCDigit.hxx>

namespace ND {
    class TSFGmcDigit;
};

/// A class to hold SFG digits generated by the MC.  This inherits all of it's
/// functionality from TSFGDigit and TMCDigit.
class ND::TSFGmcDigit : public TSFGDigit, public TMCDigit {
public:

    TSFGmcDigit ();
    virtual ~TSFGmcDigit();

    /// Construct an mc digit for a particular SFGD channel.  Most of the
    /// parameters are copied from either TSFGDigit, or TMCDigit (look there
    /// for documentation).  The new parameters for TSFGmcDigit are:
    TSFGmcDigit(ND::TChannelId chan,
                unsigned int risingEdgeTDC,
                unsigned int fallingEdgeTDC,
                unsigned int highGainADC,
                unsigned int lowGainADC,
                unsigned int risingEdgeGTSCounter,
                bool matchedADCandTDC,
                const ND::TMCDigit::ContributorContainer& contrib,
                double chargePeak, double chargeIntegral, double localIntegral,
                double measuredTime, double trueRise, double trueFall);

    /// The peak of the charge (current) in the full gate. For the correctly
    /// matched hit, this will be equal to the peak of the current between the
    /// rising and falling TDC discriminators.
    double GetChargePeak() const {return fChargePeak;}

    /// The integral of the charge (current) in the full gate.
    double GetChargeIntegral() const {return fChargeIntegral;}

    /// The integral of the charge in the peak creating the risingEdgeTDC and
    /// the fallingEdgeTDC.  This includes charge in the peak before and after
    /// the discriminator times.
    double GetLocalIntegral() const {return fLocalIntegral;}

    /// The measured time for the hit.  This includes all effects, including
    /// the electronics jitter.  This does not include the time walk, and any
    /// uncertainty in the calibrations.
    double GetMeasuredTime() const {return fMeasuredTime;}

    /// The time the signal crossed the rising threshold.  This is corrected
    /// for the calibration offset so it should be comparable to the
    /// calibrated hit time.  This will be almost equal to the measured time,
    /// except this does not include the electronics jitter.
    double GetRiseTime() const {return fRiseTime;}

    /// The time the signal crossed the falling threshold.  This is corrected
    /// for the calibration offset so it should be comparable to the
    /// calibrated hit time.
    double GetFallTime() const {return fFallTime;}

    virtual void ls(Option_t* opt = "") const;

private:
    /// The peak of the charge (current) in the full gate. For the correctly
    /// matched hit, this will be equal to the peak of the current between the
    /// rising and falling TDC discriminators.
    float fChargePeak;

    /// The integral of the charge (current) in the full gate.  If all of the
    /// hits are triggered, this will be equal to the sum of the local charges
    /// for the channel.
    float fChargeIntegral;

    /// The integral of the charge in the peak creating the risingEdgeTDC and
    /// the fallingEdgeTDC.  This includes charge in the peak before and after
    /// the discriminator times.
    float fLocalIntegral;

    /// The time of the measured edge.
    float fMeasuredTime;

    /// The time the signal crossed the rising threshold.  This is corrected
    /// for the calibration offset so it should be comparable to the
    /// calibrated hit time.
    float fRiseTime;

    /// The time the signal crossed the falling threshold.  This is corrected
    /// for the calibration offset so it should be comparable to the
    /// calibrated hit time.
    float fFallTime;

    ClassDef(TSFGmcDigit,1);
};
#endif
